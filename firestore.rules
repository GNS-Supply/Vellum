rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed(){ return request.auth != null; }
    function isMaster(){ return signed() && exists(/databases/$(db)/documents/masters/$(request.auth.uid)); }
    function acc(){ return get(/databases/$(db)/documents/acessos/$(request.auth.uid)).data; }
    function isStaff(t){ return isMaster() || (signed() && exists(/databases/$(db)/documents/acessos/$(request.auth.uid)) && acc().tenantId == t); }
    function isOwner(t){ return isMaster() || (isStaff(t) && acc().papel == 'proprietario'); }
    function can(t,p){ return isOwner(t) || (isStaff(t) && p in acc().permissoes); }
    function T(t){ return /databases/$(db)/documents/tenants/$(t); }

    match /masters/{u}  { allow read: if signed() && request.auth.uid == u; allow write: if false; }
    match /acessos/{u} {
      allow read: if signed() && (request.auth.uid == u || isMaster() || isOwner(resource.data.tenantId));
      allow write: if isMaster();
      allow create: if signed() && request.auth.uid == u
        && exists(/databases/$(db)/documents/convites/$(request.auth.token.email.lower()))
        && request.resource.data.keys().hasOnly(['tenantId','papel','unidades','permissoes','email','nome'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.tenantId == get(/databases/$(db)/documents/convites/$(request.auth.token.email.lower())).data.tenantId
        && request.resource.data.papel == get(/databases/$(db)/documents/convites/$(request.auth.token.email.lower())).data.papel
        && request.resource.data.unidades == get(/databases/$(db)/documents/convites/$(request.auth.token.email.lower())).data.unidades
        && request.resource.data.permissoes == get(/databases/$(db)/documents/convites/$(request.auth.token.email.lower())).data.permissoes;
      allow update: if isOwner(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isOwner(resource.data.tenantId);
    }
    match /convites/{e} {
      allow get: if signed() && request.auth.token.email.lower() == e;
      allow list: if signed() && isOwner(resource.data.tenantId);
      allow create, update: if signed() && isOwner(request.resource.data.tenantId) && request.resource.data.papel in ['proprietario','equipe'];
      allow delete: if signed() && (request.auth.token.email.lower() == e || isOwner(resource.data.tenantId));
    }
    match /auditoria/{i}{ allow read, create: if isMaster(); }
    match /users/{u} {
      allow read: if signed() && (request.auth.uid == u || isMaster());
      allow create, update: if signed() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['nome','email','telefone','nascimento','cpf','cep','endereco','estilo','foto','criadoEm','lgpdEm','pet'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if signed() && request.auth.uid == u;
    }
    match /tenants/{t} {
      allow read: if true;
      allow create, delete: if isMaster();
      allow update: if isMaster() || (isOwner(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fidelidade','textos','indicacao','politica','planosAtivo','nome','descricao','tema']));

      match /unidades/{i}      { allow read: if true; allow write: if isOwner(t); }
      match /profissionais/{i} { allow read: if true; allow write: if can(t,'profissionais'); }
      match /servicos/{i}      { allow read: if true; allow write: if can(t,'servicos'); }

      // travas por profissional/horário: create falha se já existir (impede reserva dupla)
      match /locks/{i} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.keys().hasOnly(['cli','u','d']) && request.resource.data.cli == request.auth.uid;
        allow delete: if signed() && (resource.data.cli == request.auth.uid || isStaff(t));
      }
      // contador de ocupação por unidade/horário, limitado à capacidade da unidade
      match /cap/{i} {
        allow read: if signed();
        allow create, update: if signed() && request.resource.data.keys().hasOnly(['n','u','d'])
          && request.resource.data.n >= 0
          && request.resource.data.n <= get(/databases/$(db)/documents/tenants/$(t)/unidades/$(request.resource.data.u)).data.capacidade;
      }
      match /agendamentos/{i} {
        allow create: if signed() && (isOwner(t) || (isStaff(t) && request.resource.data.unidadeId in acc().unidades)) && request.resource.data.status == 'agendado';
        allow read: if signed() && (resource.data.clienteUid == request.auth.uid || isOwner(t) || (isStaff(t) && resource.data.unidadeId in acc().unidades));
        allow create: if signed() && request.resource.data.clienteUid == request.auth.uid && request.resource.data.status == 'agendado'
          && request.resource.data.preco == get(/databases/$(db)/documents/tenants/$(t)/servicos/$(request.resource.data.servicoId)).data.preco
          && (request.resource.data.get('cupom','') != '' || request.resource.data.get('desconto',0) == 0)
          && (request.resource.data.get('cupom','') == '' || (get(/databases/$(db)/documents/tenants/$(t)/promocoes/$(request.resource.data.cupom)).data.ativo == true && request.resource.data.desconto <= request.resource.data.preco));
        allow update: if signed() && (isOwner(t) || (isStaff(t) && resource.data.unidadeId in acc().unidades) || (resource.data.clienteUid == request.auth.uid && request.resource.data.status == 'cancelado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) || (resource.data.clienteUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmado'])));
      }
      match /vitrine/{i} { allow read: if true; allow write: if isOwner(t); }
      match /bloqueios/{i} {
        allow read: if true;
        allow create: if isOwner(t) || (can(t,'bloqueios') && request.resource.data.unidadeId in acc().unidades);
        allow delete: if isOwner(t) || (can(t,'bloqueios') && resource.data.unidadeId in acc().unidades);
      }
      match /avisos/{i}    { allow read: if signed(); allow write: if isOwner(t); }
      match /metas/{i}     { allow read, write: if isOwner(t); }
      match /promocoes/{i} {
        allow get: if true;
        allow list: if isStaff(t) || resource.data.emailCliente == "" || (signed() && resource.data.emailCliente == request.auth.token.email);
        allow write: if isOwner(t);
      }
      match /clientes/{i}  { allow read, write: if isOwner(t); }
      match /despesas/{i}  { allow read, write: if isOwner(t); }
      match /planos/{i} { allow read: if true; allow write: if isOwner(t); }
      match /assinaturas/{i} {
        allow read: if signed() && (isStaff(t) || resource.data.clienteUid == request.auth.uid);
        allow create: if signed() && request.resource.data.clienteUid == request.auth.uid && request.resource.data.status == 'solicitado'
          && request.resource.data.restantes == request.resource.data.sessoes
          && request.resource.data.preco == get(/databases/$(db)/documents/tenants/$(t)/planos/$(request.resource.data.planoId)).data.preco
          && request.resource.data.sessoes == get(/databases/$(db)/documents/tenants/$(t)/planos/$(request.resource.data.planoId)).data.sessoes;
        allow update: if isStaff(t);
      }
      match /produtos/{i} { allow read: if isStaff(t); allow write: if can(t,'produtos'); }
      match /vendas/{i}   { allow read: if isOwner(t); allow create: if can(t,'produtos'); }
      match /espera/{i} {
        allow read, delete: if signed() && (resource.data.clienteUid == request.auth.uid || isOwner(t) || (isStaff(t) && resource.data.unidadeId in acc().unidades));
        allow create: if signed() && request.resource.data.clienteUid == request.auth.uid;
      }
      match /avaliacoes/{i} {
        allow read: if resource.data.publica == true || (signed() && (resource.data.cli == request.auth.uid || can(t,'avaliacoes')));
        allow create: if signed() && request.resource.data.cli == request.auth.uid && request.resource.data.publica == false
          && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
          && request.resource.data.keys().hasOnly(['cli','nome','profId','profNome','nota','txt','publica','em'])
          && get(/databases/$(db)/documents/tenants/$(t)/agendamentos/$(i)).data.clienteUid == request.auth.uid
          && get(/databases/$(db)/documents/tenants/$(t)/agendamentos/$(i)).data.status == 'concluido';
        allow update: if can(t,'avaliacoes') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publica']);
      }
      match /fidelidade/{u} { allow read: if signed() && (request.auth.uid == u || isStaff(t)); allow write: if isStaff(t); }
    }
  }
}
