rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed(){ return request.auth != null; }
    function isMaster(){ return signed() && exists(/databases/$(db)/documents/masters/$(request.auth.uid)); }
    function acc(){ return get(/databases/$(db)/documents/acessos/$(request.auth.uid)).data; }
    function isStaff(t){ return signed() && exists(/databases/$(db)/documents/acessos/$(request.auth.uid)) && acc().tenantId == t; }
    function isOwner(t){ return isStaff(t) && acc().papel == 'proprietario'; }
    function T(t){ return /databases/$(db)/documents/tenants/$(t); }

    match /masters/{u}  { allow read: if signed() && request.auth.uid == u; allow write: if false; }
    match /acessos/{u}  { allow read: if signed() && (request.auth.uid == u || isMaster()); allow write: if isMaster(); }
    match /auditoria/{i}{ allow read, create: if isMaster(); }
    match /users/{u} {
      allow read: if signed() && (request.auth.uid == u || isMaster());
      allow create, update: if signed() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['nome','email','telefone','nascimento','cpf','cep','endereco','estilo','foto','criadoEm','lgpdEm'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if signed() && request.auth.uid == u;
    }
    match /tenants/{t} {
      allow read: if true;
      allow create, delete: if isMaster();
      allow update: if isMaster() || (isOwner(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','descricao','tema','fidelidade']));

      match /unidades/{i}      { allow read: if true; allow write: if isOwner(t); }
      match /profissionais/{i} { allow read: if true; allow write: if isOwner(t); }
      match /servicos/{i}      { allow read: if true; allow write: if isOwner(t); }

      // travas por profissional/horário: create falha se já existir (impede reserva dupla)
      match /locks/{i} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.keys().hasOnly(['cli','u','d']) && request.resource.data.cli == request.auth.uid;
        allow delete: if signed() && (resource.data.cli == request.auth.uid || isStaff(t));
      }
      // contador de ocupação por unidade/horário, limitado à capacidade da unidade
      match /cap/{i} {
        allow read: if signed();
        allow create, update: if signed() && request.resource.data.keys().hasOnly(['n','u','d'])
          && request.resource.data.n >= 0
          && request.resource.data.n <= get(/databases/$(db)/documents/tenants/$(t)/unidades/$(request.resource.data.u)).data.capacidade;
      }
      match /agendamentos/{i} {
        allow read: if signed() && (resource.data.clienteUid == request.auth.uid || isStaff(t));
        allow create: if signed() && request.resource.data.clienteUid == request.auth.uid && request.resource.data.status == 'agendado'
          && request.resource.data.preco == get(/databases/$(db)/documents/tenants/$(t)/servicos/$(request.resource.data.servicoId)).data.preco;
        allow update: if signed() && (isStaff(t) || (resource.data.clienteUid == request.auth.uid && request.resource.data.status == 'cancelado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      }
      match /fidelidade/{u} { allow read: if signed() && (request.auth.uid == u || isStaff(t)); allow write: if isStaff(t); }
    }
  }
}
